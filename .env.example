# offload-ingest configuration.
#
# Copy to .env and fill in. .env is gitignored; this template is not, so it must
# never contain a real credential.

# --- API-Sports: the primary provider ---------------------------------------
#
# One key authenticates all twelve sport hosts, but the QUOTA IS PER HOST: the
# free plan grants 100 requests/day and 10/min to each of football, basketball,
# american-football and the rest independently, not 100 shared between them. The
# rate limiter budgets per host for that reason.
APISPORTS_KEY=

# --- Mode --------------------------------------------------------------------
#
# simulation  generated payloads, no upstream call, no quota spent (default)
# production  live API-Sports ingest, paced by the licence tier
#
# Simulation is the default on purpose: a mis-typed value should waste nobody's
# request budget.
OFFLOAD_MODE=simulation

# --- Licensing ---------------------------------------------------------------
#
# The licence carries the tenant, the entitled sports and regions, the hardware
# pin, and the API tier the rate limiter is sized from. A release build embeds
# the public key with -ldflags; this variable is the development path.
OFFLOAD_LICENSE_PATH=license.key
OFFLOAD_LICENSE_PUBKEY=

# --- Observability -----------------------------------------------------------
#
# The dashboard is for a human on the venue LAN; /metrics is for a scraper that
# may be firewalled differently, so they bind separate listeners.
#
# 9102 rather than 9090: 9090 is Prometheus server's own default port, and an
# appliance running Prometheus locally would have the two fight over the bind.
OFFLOAD_DASHBOARD_ADDR=:8090
OFFLOAD_METRICS_ADDR=:9102

# Optional. Flink runs as a separate process, so the state-buffer gauge belongs
# to the Flink product's dashboard; set this only to surface it here too.
OFFLOAD_FLINK_ADDR=

# --- Secondary providers -----------------------------------------------------
#
# API-Sports has no host for cricket, tennis or golf — verified by probing every
# plausible name — so those three are reached through RapidAPI vendors. There is
# no third vendor: SportsDataIO was retired with NASCAR.

# Golf. The feed comes from live-golf-data, which is RapidAPI-hosted, so this
# falls back to RAPIDAPI_KEY below when unset. Set it only if golf is ever given
# its own separately-metered subscription.
GOLF_API_KEY=
# Where the golf provider caches its leaderboard. Defaults to
# testdata/golf_cache.json, which is gitignored.
GOLF_CACHE_PATH=

# RapidAPI — one key, one host per provider. This key also enables live
# cricket ingest: Cricbuzz is RapidAPI-hosted, and the runtime reads it as
# CricketAPIKey. Unset it and cricket stays simulated.
RAPIDAPI_KEY=
RAPIDAPI_CRICKET_HOST=cricbuzz-cricket.p.rapidapi.com
RAPIDAPI_ALLSCORES_HOST=allscores.p.rapidapi.com

# --- Deployment (deployments/docker-compose.yml) ----------------------------
#
# These are read by Compose rather than by the binary, so they matter only when
# the appliance is started from deployments/ with the `production` profile.

# Host path to the signed licence. Mounted read-only at /etc/offload/license.key
# inside the container: the process verifies the licence, it never rewrites it.
OFFLOAD_LICENSE_FILE=./license.key

# Stamped onto every Prometheus series as the `venue` label. Prometheus label
# expansion has no default form, so an unset value produces an unlabelled
# series that a fleet-wide Grafana cannot attribute to any venue. Set it per
# site. See TODO.md, "Tenant labelling".
VENUE_ID=

# Stamped into the binary at build time; all three are optional.
VERSION=dev
COMMIT=none
BUILD_DATE=unknown

# Where the cricket provider caches its scorecard. Defaults to
# testdata/cricket_cache.json, which is gitignored.
CRICKET_CACHE_PATH=
